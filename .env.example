# Key the clients (and the admin page) send as "Authorization: Bearer ...".
# Required: inside the container the bridge listens on all interfaces.
AGENT_BRIDGE_API_KEY=change-me-to-a-long-random-string

# subscription: CLIs logged in from the admin page; api: API keys below.
AGENT_BRIDGE_AUTH_MODE=subscription

# Image: empty builds it locally (make build); a published release is pulled
# with make pull, e.g. paolor/agent-bridge:latest or a version.
AGENT_BRIDGE_IMAGE=

# Host ports (published on 127.0.0.1 only).
CLAUDE_PORT=8787
CODEX_PORT=8788
KIMI_PORT=8789

# Kimi login: global (kimi.ai, outside mainland China) or mainland-cn (kimi.com).
AGENT_BRIDGE_KIMI_REGION=global

# api mode only: leave empty in subscription mode.
ANTHROPIC_API_KEY=
CODEX_API_KEY=
KIMI_MODEL_NAME=
KIMI_MODEL_API_KEY=
